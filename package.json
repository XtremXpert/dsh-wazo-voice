{
  "name": "dsh-wazo-voice",
  "version": "0.1.0",
  "type": "module",
  "description": "Voice bridge between a Wazo/Asterisk PBX (AudioSocket) and a DeepSeek Harness session: local speech recognition and synthesis, hold music, spoken text replies.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "wazo",
    "asterisk",
    "audiosocket",
    "voice",
    "whisper",
    "kokoro",
    "telephony"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XtremXpert/dsh-wazo-voice.git"
  },
  "homepage": "https://github.com/XtremXpert/dsh-wazo-voice#readme",
  "bugs": {
    "url": "https://github.com/XtremXpert/dsh-wazo-voice/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
